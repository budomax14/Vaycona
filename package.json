{
  "name": "personal-canva-editor",
  "productName": "Vaycona",
  "private": true,
  "version": "1.0.0",
  "description": "Vaycona design editor",
  "author": "Vaycona",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "desktop": "vite build && electron .",
    "desktop:dev": "VAYCONA_DEV_URL=http://localhost:9021 electron .",
    "desktop:build:mac": "vite build && electron-builder --mac",
    "desktop:build:win": "vite build && electron-builder --win",
    "mobile:sync": "vite build && cap sync",
    "ios": "npm run mobile:sync && cap open ios",
    "android": "npm run mobile:sync && cap open android",
    "ios:release": "npm run mobile:sync && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Release -destination generic/platform=iOS -archivePath release/ios/Vaycona.xcarchive CODE_SIGNING_ALLOWED=NO archive && xcodebuild -exportArchive -archivePath release/ios/Vaycona.xcarchive -exportPath release/ios -exportOptionsPlist ios/ExportOptions.plist -allowProvisioningUpdates"
  },
  "build": {
    "appId": "com.vaycona.app",
    "productName": "Vaycona",
    "directories": {
      "output": "release",
      "buildResources": "electron/resources"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json",
      "!**/node_modules/**"
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "electron/resources/entitlements.mac.plist",
      "entitlementsInherit": "electron/resources/entitlements.mac.plist",
      "notarize": false
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.4",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/share": "^8.0.3",
    "@fontsource/alex-brush": "^5.3.0",
    "@fontsource/alfa-slab-one": "^5.3.0",
    "@fontsource/almendra": "^5.3.0",
    "@fontsource/anton": "^5.3.0",
    "@fontsource/archivo-black": "^5.3.0",
    "@fontsource/bangers": "^5.3.0",
    "@fontsource/bebas-neue": "^5.3.0",
    "@fontsource/berkshire-swash": "^5.3.0",
    "@fontsource/bitter": "^5.3.0",
    "@fontsource/bungee": "^5.3.0",
    "@fontsource/caveat": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/cinzel-decorative": "^5.3.0",
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/dancing-script": "^5.3.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/domine": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/fjalla-one": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/great-vibes": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/im-fell-english": "^5.3.0",
    "@fontsource/indie-flower": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jersey-25": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/josefin-sans": "^5.3.0",
