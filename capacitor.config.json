{
  "appId": "com.vaycona.app",
  "appName": "Vaycona",
  "webDir": "dist",
  "ios": {
    "contentInset": "never"
  },
  "plugins": {
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com", "apple.com"]
    }
  },
  "experimental": {
    "ios": {
      "spm": {
        "swiftToolsVersion": "6.1",
        "packageOptions": {
          "@capacitor-firebase/authentication": {
            "symlink": true
          }
        },
        "packageTraits": {
          "@capacitor-firebase/authentication": ["Google"]
        }
      }
    }
  }
}
