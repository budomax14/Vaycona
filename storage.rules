rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Images an admin uploads while editing a template (see
    // src/templateAssetStorage.js) — any signed-in user needs to read them
    // to use the template; only the admin account may write/replace them.
    // Mirrors firestore.rules' publishedTemplates rule.
    match /templateAssets/{templateId}/{assetId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'budomax1995@gmail.com';
    }

    // A signed-in user's own uploaded images (see src/cloudAssetStorage.js)
    // — permanent storage for the Uploads panel, replacing what used to
    // live only in IndexedDB. Only the uploader can read/write their own
    // folder; size/type limits here mirror assetStore.js's
    // MAX_UPLOAD_BYTES/ACCEPTED_IMAGE_MIME_TYPES so a client can't bypass
    // them by talking to Storage directly.
    match /userUploads/{uid}/{assetId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid
        && request.resource.size < 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
