rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The admin-published template gallery (see src/firestoreTemplates.js).
    // Any signed-in user (this app requires login for everyone) can read
    // the gallery; only the admin account can write to it.
    match /publishedTemplates/{templateId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email == 'budomax1995@gmail.com';
    }

    // Subscription state (tier/status/Stripe customer+subscription ids).
    // Only the Stripe webhook Cloud Function (Admin SDK, bypasses rules)
    // ever writes here — a client has no legitimate reason to set its own
    // subscription tier.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Metadata for a user's own uploaded images (see
    // src/cloudAssetStorage.js) — the bytes live in Firebase Storage at
    // userUploads/{uid}/{assetId} (see storage.rules); this doc just
    // records the download URL + dimensions/size/etc so it can be found
    // again after this browser's local IndexedDB cache is cleared. Only
    // the uploader can read or write their own asset docs.
    match /users/{uid}/assets/{assetId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Client Personalization (Business plan, see functions/personalization.js).
    // Every write goes through the Cloud Functions, which check ownership,
    // the Business entitlement and the published field definitions; a
    // business can only READ its own templates, versions and submissions
    // here (queries must filter on ownerUid). Customer sessions, link
    // lookups and rate-limit counters are server-only — customers never
    // talk to Firestore directly.
    match /personalizationTemplates/{templateId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow write: if false;

      match /versions/{versionId} {
        allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
        allow write: if false;
      }
    }
    match /personalizationSubmissions/{submissionId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow write: if false;
    }
    match /personalizationSessions/{sessionId} {
      allow read, write: if false;
    }
    match /personalizationLinks/{linkHash} {
      allow read, write: if false;
    }
    match /personalizationRateLimits/{key} {
      allow read, write: if false;
    }
  }
}
